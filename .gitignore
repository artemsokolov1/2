# Unreal Engine — генерируемые при сборке и запуске папки
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/

# IDE
.vs/
.idea/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# 3D-модель футболиста импортируется редактором автоматически из SourceArt/Footballer —
# импортированные .uasset в репозиторий не кладём (их легко пересоздать, а весят они много)
Content/Characters/Footballer/*
!Content/Characters/Footballer/.gitkeep

# Текстуры, которые Blender извлекает из FBX
SourceArt/**/*.fbm/

# Motion Matching из Epic Game Animation Sample (~3 ГБ) — не храним в репозитории,
# восстанавливается скриптом Scripts/migrate_gasp.py из скачанного проекта-примера
Content/Audio/
Content/Blueprints/
Content/Collections/
Content/Developers/
Content/MetaHumans/
Content/Misc/
Content/Characters/Echo/
Content/Characters/Paragon/
Content/Characters/UE4_Mannequin/
Content/Characters/UE5_Mannequins/
Content/Characters/UEFN_Mannequin/

# Free mocap pack 05: Soccer (Anderson Rohr) — can be used in the game, but the pack itself
# must not be redistributed, so the source files stay out of the repository
SourceArt/MocapSoccer/

# Poly Haven CC0 downloads (Scripts/fetch_polyhaven.py re-creates them)
SourceArt/Environment/PolyHaven/
SourceArt/Environment/Export/
# Poly Haven props (Scripts/import_environment.py re-creates them)
Content/Environment/Props/

# Паки с Fab и импортированные ассеты арены — тяжёлые (Iceland 1.2 ГБ, Meshy ~0.6 ГБ),
# облачным агентам не нужны. Арена восстанавливается скриптами:
#   Scripts/meshy_generate.py (модели Meshy), Scripts/import_zoo_arena.py, Scripts/fix_zoo_instancing.py
Content/Iceland_Environment/
Content/Fab/
Content/LP_RocksandCliffs/
Content/Environment/Zoo/
SourceArt/Environment/Zoo/Meshy/*.glb
SourceArt/**/*.blend
SourceArt/**/*.blend1
